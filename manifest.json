{
  "manifest_version": 3,
  "name": "Cambly Transcript Copier",
  "version": "1.0",
  "description": "Copy Cambly lesson transcripts with a Japanese revision prompt for Claude.ai",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["*://www.cambly.com/en/student/progress/past-lesson*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  }
}
